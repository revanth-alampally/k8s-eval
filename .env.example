# Copy to .env and adjust. All settings are prefixed with KAGENT_.

KAGENT_ENVIRONMENT=local
KAGENT_LOG_LEVEL=INFO
# json for production-style output, console for readable local development
KAGENT_LOG_FORMAT=console

KAGENT_API_HOST=127.0.0.1
KAGENT_API_PORT=8000

# Kubernetes: leave KUBECONFIG_PATH empty to use the default ~/.kube/config
KAGENT_KUBECONFIG_PATH=
# Leave empty to use whatever context is currently active.
KAGENT_KUBE_CONTEXT=
# Comma-separated allowlist. The agent refuses to touch anything outside it.
KAGENT_ALLOWED_NAMESPACES=ai-agent-demo

# Safety switches
KAGENT_READ_ONLY_MODE=false
KAGENT_REQUIRE_CONFIRMATION=true
KAGENT_CONFIRMATION_TTL_SECONDS=300

# LLM. Default `fake` is a keyword-driven stand-in that needs no API key.
KAGENT_LLM_PROVIDER=fake
KAGENT_LLM_MODEL=gpt-4o-mini
KAGENT_LLM_API_KEY=
KAGENT_LLM_TIMEOUT_SECONDS=30
KAGENT_MAX_TOOL_CALLS_PER_REQUEST=5

# Repository-owned documentation retrieval. Paths are comma-separated and must stay
# within this repository; Cursor/system skills are deliberately never indexed by default.
KAGENT_RAG_ENABLED=true
KAGENT_RAG_CORPUS_PATHS=README.md
KAGENT_RAG_PERSIST_DIRECTORY=.data/chroma
KAGENT_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KAGENT_RAG_CHUNK_SIZE=1800
KAGENT_RAG_CHUNK_OVERLAP=240
KAGENT_RAG_TOP_K=4
